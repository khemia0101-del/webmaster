# Copy this file to .env.local for local development.
# In Vercel, add the same enabled variables under Project Settings > Environment Variables.
# Never commit .env.local or put a private/secret key in a NEXT_PUBLIC_ variable.

# -----------------------------------------------------------------------------
# Core production configuration
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://conquistadoroil.com

# Supabase is the server-side CRM system of record.
SUPABASE_URL=https://qnxizmyyvhxhiwycwrod.supabase.co
SUPABASE_SECRET_KEY=

# Reference only (not consumed by the current server-only app):
# Project ref: qnxizmyyvhxhiwycwrod
# Publishable key: sb_publishable_jIkxL4F78PAHd6UebqRYHw_0f24hOWD
# Do not add NEXT_PUBLIC_SUPABASE_* variables unless browser-side Supabase is
# deliberately implemented later.

# -----------------------------------------------------------------------------
# Protected internal features
# -----------------------------------------------------------------------------

# Optional Basic Auth. When these are blank/unset, /admin and protected routes
# remain locked in production, but their absence does not fail readiness.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Generate this value yourself (64+ random characters) if the Celina command
# endpoint is enabled. Leave blank only when that endpoint is intentionally off.
CELINA_COMMAND_SECRET=

# Optional hosted Hermes / Conquistador Revenue Desk webhook. Configure both
# only when a real endpoint exists; never fabricate one.
HERMES_REVENUE_DESK_WEBHOOK_URL=
HERMES_REVENUE_DESK_SECRET=

# -----------------------------------------------------------------------------
# Vapi inbound phone line
# -----------------------------------------------------------------------------

# Generate this shared secret yourself (64+ random characters).
# In Vapi Dashboard > Phone Numbers > your inbound number:
#   1. Leave the fixed Assistant selection empty so Vapi requests one dynamically.
#   2. Set Server URL to https://conquistadoroil.com/api/vapi/webhook
#   3. Add this same secret through a Vapi Custom Credential or HTTP header.
#      The app accepts `Authorization: Bearer <secret>` or `X-Vapi-Secret: <secret>`.
VAPI_WEBHOOK_SECRET=

# These are optional overrides; the shown values are already the app defaults.
# VAPI_MODEL_PROVIDER=openai
# VAPI_MODEL=gpt-5.4-mini
# PHONE_ROUTING_MIN_CONTRACTORS=3

# The inbound-only flow does not need VAPI_PRIVATE_KEY or a phone-number ID.

# -----------------------------------------------------------------------------
# Zoho SMTP notifications (Zoho is email-only, never the CRM)
# -----------------------------------------------------------------------------

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
ZOHO_FROM_EMAIL=info@conquistadoroil.com
ZOHO_FROM_NAME=Conquistador Oil
PHONE_LEAD_NOTIFICATION_EMAIL=info@conquistadoroil.com
CONTRACTOR_OUTREACH_NOTIFICATION_EMAIL=info@conquistadoroil.com

# -----------------------------------------------------------------------------
# Vapi outbound contractor qualification
# -----------------------------------------------------------------------------

# Get this from Vapi Dashboard > API Keys > Private API Keys.
# Use a private server key, not a Vapi public browser key.
VAPI_PRIVATE_KEY=

# Get this from Vapi Dashboard > Phone Numbers > the number calls should use.
# This is the Vapi phone-number record ID, not the displayed telephone number.
VAPI_OUTBOUND_PHONE_NUMBER_ID=

# Generate this separate shared secret yourself (64+ random characters).
# It is not a Vapi API key. The app attaches it automatically to the transient
# assistant's outbound webhook requests.
VAPI_OUTBOUND_WEBHOOK_SECRET=

# Optional overrides; the shown values are already the app defaults.
# VAPI_OUTBOUND_MODEL=gpt-5.4
# VAPI_OUTBOUND_VOICE_ID=Elliot

# -----------------------------------------------------------------------------
# Local development only
# -----------------------------------------------------------------------------

# Production always requires Supabase and never uses this JSON fallback path.
# DATA_DIR=.data
