# Public app URL
NEXT_PUBLIC_SITE_URL=https://REPLACE_WITH_YOUR_DOMAIN

# Admin and internal command authentication
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
CELINA_COMMAND_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET

# Optional hosted Hermes / Conquistador Revenue Desk webhook.
# Leave both blank until a real endpoint exists.
HERMES_REVENUE_DESK_WEBHOOK_URL=
HERMES_REVENUE_DESK_SECRET=

# Vapi inbound webhook
# Create a Vapi Bearer Token custom credential containing VAPI_WEBHOOK_SECRET,
# then paste the resulting credential ID into VAPI_SERVER_CREDENTIAL_ID.
VAPI_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET
VAPI_SERVER_CREDENTIAL_ID=REPLACE_WITH_VAPI_CREDENTIAL_ID
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini
PHONE_ROUTING_MIN_CONTRACTORS=3

# Zoho SMTP is the durable no-database phone-lead inbox.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=REPLACE_WITH_ZOHO_MAILBOX
ZOHO_SMTP_PASS=REPLACE_WITH_ZOHO_APP_PASSWORD
ZOHO_FROM_EMAIL=info@conquistadoroil.com
ZOHO_FROM_NAME=Conquistador Oil
PHONE_LEAD_NOTIFICATION_EMAIL=info@conquistadoroil.com

# Optional local development override. Do not set DATA_DIR on Vercel.
# DATA_DIR=.data
