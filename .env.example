# Public app URL
NEXT_PUBLIC_SITE_URL=https://REPLACE_WITH_YOUR_DOMAIN

# Durable CRM database (server-only; never prefix the secret with NEXT_PUBLIC_).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_SUPABASE_SECRET_KEY

# Admin and internal command authentication
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
CELINA_COMMAND_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET

# Optional hosted Hermes / Conquistador Revenue Desk webhook.
# Leave both blank until a real endpoint exists.
HERMES_REVENUE_DESK_WEBHOOK_URL=
HERMES_REVENUE_DESK_SECRET=

# Vapi inbound webhook. Only needed when the phone number is connected.
# Vapi must send this value in Authorization: Bearer ... or X-Vapi-Secret.
VAPI_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET

# Optional overrides; these defaults are already built into the app.
# VAPI_MODEL_PROVIDER=openai
# VAPI_MODEL=gpt-5.4-mini
# PHONE_ROUTING_MIN_CONTRACTORS=3

# Zoho SMTP sends customer and internal notification email. Supabase is the CRM record.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=REPLACE_WITH_ZOHO_MAILBOX
ZOHO_SMTP_PASS=REPLACE_WITH_ZOHO_APP_PASSWORD
ZOHO_FROM_EMAIL=info@conquistadoroil.com
ZOHO_FROM_NAME=Conquistador Oil
PHONE_LEAD_NOTIFICATION_EMAIL=info@conquistadoroil.com

# Vapi outbound contractor qualification (server-only).
# This is the Vapi dashboard private key. The public key is not used server-side.
VAPI_PRIVATE_KEY=
VAPI_OUTBOUND_PHONE_NUMBER_ID=
VAPI_OUTBOUND_WEBHOOK_SECRET=
CONTRACTOR_OUTREACH_NOTIFICATION_EMAIL=info@conquistadoroil.com

# Optional model override; the app defaults to the Vapi-documented gpt-5.4.
# VAPI_OUTBOUND_MODEL=gpt-5.4
# VAPI_OUTBOUND_VOICE_ID=Elliot

# Optional local-development fallback. Production requires Supabase and never uses this path.
# DATA_DIR=.data
